# Copy to .env and fill in. .env is gitignored -- never commit real credentials.
# Only the `scrape` command reads any of this; analysis and training need none of it.

# --- X / Twitter login used by the Selenium collector -----------------------
TWITTER_USERNAME=your_handle_without_the_at
TWITTER_EMAIL=you@example.com
TWITTER_PASSWORD=your_password

# --- Browser ----------------------------------------------------------------
# Absolute path to chromedriver. Leave blank to let webdriver-manager download
# a matching driver automatically (needs network access on first run).
CHROMEDRIVER_PATH=
# Run Chrome without a visible window. Logins often trip anti-bot checks when
# headless, so keep this false for the first run.
SCRAPER_HEADLESS=false

# --- Collection defaults ----------------------------------------------------
SCRAPER_QUERY=#Budget2025
SCRAPER_MAX_SCROLLS=40
SCRAPER_SCROLL_PAUSE_MIN=1.0
SCRAPER_SCROLL_PAUSE_MAX=3.0
SCRAPER_PAGE_TIMEOUT=20
